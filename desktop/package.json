{
  "name": "valistruct-desktop",
  "version": "5.4.0-beta.1",
  "description": "ValiStruct Desktop 5.4 Beta · Validación de instrumentos, persistencia y endurecimiento post-Fase 2",
  "main": "main-patched.js",
  "author": "Dr. Roberto Joel Tirado Reyes",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist": "electron-builder --win nsis --mac dmg",
    "pack:win": "electron-builder --win dir"
  },
  "dependencies": {
    "tar": "7.5.22",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "mx.uas.valistruct",
    "productName": "ValiStruct",
    "artifactName": "ValiStruct-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main-patched.js",
      "renderer-fixes.js",
      "preload.js",
      "ux-shell.js",
      "ux-shell.css",
      "excel-import.js"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "app/index.html"
      },
      {
        "from": "../app.js",
        "to": "app/app.js"
      },
      {
        "from": "../navigation-v51.js",
        "to": "app/navigation-v51.js"
      },
      {
        "from": "../v52-shell.js",
        "to": "app/v52-shell.js"
      },
      {
        "from": "../v52.css",
        "to": "app/v52.css"
      },
      {
        "from": "../efa-v52.css",
        "to": "app/efa-v52.css"
      },
      {
        "from": "../efa-v52.js",
        "to": "app/efa-v52.js"
      },
      {
        "from": "../participant-data.js",
        "to": "app/participant-data.js"
      },
      {
        "from": "../jasp-import.js",
        "to": "app/jasp-import.js"
      },
      {
        "from": "../styles.css",
        "to": "app/styles.css"
      },
      {
        "from": "../manifest.webmanifest",
        "to": "app/manifest.webmanifest"
      },
      {
        "from": "../icons",
        "to": "app/icons"
      },
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "runtime/valistruct-runtime.tar.gz",
        "to": "runtime/valistruct-runtime.tar.gz"
      },
      {
        "from": "../version.json",
        "to": "version.json"
      },
      {
        "from": "../release/runtime-v5.4-beta1.json",
        "to": "runtime-v5.4-beta1.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
